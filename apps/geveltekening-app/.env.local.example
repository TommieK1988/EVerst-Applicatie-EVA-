# ============================================================
# Geveltekening App — environment variabelen
# ============================================================
# Kopieer dit bestand naar .env.local en vul de waarden in.

# --- Mapillary (gratis, crowd-sourced street-level foto's) ---
# Maak een app aan op https://www.mapillary.com/dashboard/developers
# en genereer een Client Token. Verplicht voor gevelfoto's.
MAPILLARY_ACCESS_TOKEN=

# --- Anthropic Claude (voor Vision elementherkenning) ---
# Haal een key op bij https://console.anthropic.com/
# Nodig voor automatische herkenning van ramen, deuren, kozijnen.
ANTHROPIC_API_KEY=

# ============================================================
# OPTIONEEL — PDOK BAG en 3D BAG hebben GEEN API key nodig
# (open data van de Nederlandse overheid / TU Delft)
# ============================================================
