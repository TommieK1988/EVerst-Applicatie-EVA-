# Supabase (zelfde project als andere apps)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role: alleen server-side gebruikt (compliance, RDW refresh)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Directe Postgres-connectie (voor bulk writes, omzeilt PostgREST cache).
# Vind deze in Supabase → Project Settings → Database → Connection string.
# Gebruik de "Transaction pooler" (port 6543) voor serverless/dev-gebruik.
# Voorbeeld: postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ULU Cartracker API credentials
ULU_EMAIL=jouw.login@voorbeeld.nl
ULU_PASSWORD=je-ulu-wachtwoord
# Optioneel: override base URL (default: https://live.cartracker.nl/api/v1)
# ULU_API_BASE_URL=https://live.cartracker.nl/api/v1
