{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_O365_CONFIGURED",
        "SUPABASE_SERVICE_ROLE_KEY",
        "O365_CLIENT_ID",
        "O365_CLIENT_SECRET",
        "O365_TENANT_ID",
        "O365_REDIRECT_URI",
        "O365_PDF_DRIVE_ID",
        "O365_SHAREPOINT_SITE_ID"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
