# =====================================================================
# Everts Platform — Environment variabelen
# =====================================================================
# Kopieer dit bestand naar .env.local in elke app die Supabase nodig heeft:
#   apps/dashboard/.env.local
#   apps/everts-calc/.env.local
#   apps/houtrotherstel-app/.env.local
#   apps/taken/.env.local
#
# Offertegenerator gebruikt geen Supabase en heeft geen .env nodig.
# =====================================================================

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...jouw-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...jouw-service-role-key

# Office 365 koppeling (optioneel — voor medewerker-account sync)
# Maak een Azure App Registration aan op https://portal.azure.com
# Redirect URI: http://localhost:3000/api/auth/o365/callback (dev)
# Delegated scopes: offline_access User.Read Tasks.ReadWrite Calendars.ReadWrite Mail.Read Mail.Send
#
# App-only (client credentials) voor SharePoint/Graph — vereist admin consent:
#   Sites.Selected  + per site een grant met roles:["write"]
#                     (POST /sites/{site-id}/permissions; 'read' volstaat niet,
#                      EVA maakt dossiermappen aan)
# Grant de site van O365_DOSSIER_DRIVE_ID én die van O365_PDF_DRIVE_ID.
# O365_TENANT_ID moet voor app-only de échte tenant-GUID zijn, niet 'common'.
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=common
O365_REDIRECT_URI=http://localhost:3000/api/auth/o365/callback
# Gedeelde drive voor docx→pdf-conversie (Graph)
O365_PDF_DRIVE_ID=
# SharePoint-dossierbibliotheek (drive-id of deel-link) voor bestanden + offerte-archief.
# Wijst naar de map waarin de dossiermappen staan ({dossiernummer} - {titel}).
O365_DOSSIER_DRIVE_ID=
